# Konfigurasi Supabase (wajib diisi untuk aplikasi berjalan)
# Salin ke .env dan isi nilai sesuai project Supabase Anda.

NEXT_PUBLIC_SUPABASE_URL=https://contoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-anda
SUPABASE_SERVICE_ROLE_KEY=service-role-key-anda

# Prisma (data aplikasi)
DATABASE_URL="postgresql://user:password@localhost:5432/literacy"

# Admin registration (server-side only; never expose NEXT_PUBLIC)
ADMIN_REGISTRATION_PIN=""
