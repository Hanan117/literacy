# Prisma (app data). For local testing you can run Postgres in Docker and point DATABASE_URL here.
DATABASE_URL="postgresql://user:password@localhost:5432/literacy"

# Supabase Auth (Plan B: app local, Supabase cloud/local stack)
# Port non-default agar tidak bentrok dengan range port dinamis Windows/Hyper-V:
#   API  : http://127.0.0.1:44321
#   DB   : postgresql://postgres:postgres@127.0.0.1:44322/postgres
#   Mail : http://127.0.0.1:44324
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Admin registration (server-side only; never expose NEXT_PUBLIC)
ADMIN_REGISTRATION_PIN=""
